<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проверка совместимости с Native AOT: dotnet publish -c Release
    Публикация должна пройти без предупреждений тримминга/AOT, а программа — завершиться с кодом 0.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Haskimail\Haskimail.csproj" />
    <ProjectReference Include="..\..\src\Haskimail.Extensions.DependencyInjection\Haskimail.Extensions.DependencyInjection.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
  </ItemGroup>

</Project>
